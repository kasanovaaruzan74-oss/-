digraph DeanFlow {
graph [bgcolor="#ffffff" rankdir=LR ranksep=1.14 nodesep=0.42 pad=0.32]
graph [fontname="DejaVu Sans" fontsize=19 label="DeanFlow · ER-диаграмма учебной базы" labelloc=t]
node [shape=plain fontname="DejaVu Sans"]
edge [color="#586d81" penwidth=1.12 arrowhead=crow]
roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>roles</B></FONT></TD></TR><TR><TD PORT="role_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> role_id</TD></TR><TR><TD PORT="role_name" ALIGN="LEFT">role_name</TD></TR></TABLE>>]
departments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>departments</B></FONT></TD></TR><TR><TD PORT="department_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> department_id</TD></TR><TR><TD PORT="department_name" ALIGN="LEFT">department_name</TD></TR></TABLE>>]
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>users</B></FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> user_id</TD></TR><TR><TD PORT="role_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> role_id</TD></TR><TR><TD PORT="department_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> department_id</TD></TR><TR><TD PORT="full_name" ALIGN="LEFT">full_name</TD></TR><TR><TD PORT="email" ALIGN="LEFT">email</TD></TR></TABLE>>]
document_types [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>document_types</B></FONT></TD></TR><TR><TD PORT="document_type_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> document_type_id</TD></TR><TR><TD PORT="type_name" ALIGN="LEFT">type_name</TD></TR></TABLE>>]
document_statuses [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>document_statuses</B></FONT></TD></TR><TR><TD PORT="status_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> status_id</TD></TR><TR><TD PORT="status_code" ALIGN="LEFT">status_code</TD></TR></TABLE>>]
documents [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>documents</B></FONT></TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> document_id</TD></TR><TR><TD PORT="registration_number" ALIGN="LEFT">registration_number</TD></TR><TR><TD PORT="document_type_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> document_type_id</TD></TR><TR><TD PORT="status_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> status_id</TD></TR><TR><TD PORT="department_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> department_id</TD></TR><TR><TD PORT="created_by_user_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> created_by_user_id</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD></TR><TR><TD PORT="due_date" ALIGN="LEFT">due_date</TD></TR></TABLE>>]
document_executors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>document_executors</B></FONT></TD></TR><TR><TD PORT="assignment_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> assignment_id</TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> document_id</TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> user_id</TD></TR><TR><TD PORT="assigned_by_user_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> assigned_by_user_id</TD></TR><TR><TD PORT="due_date" ALIGN="LEFT">due_date</TD></TR></TABLE>>]
document_approvals [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>document_approvals</B></FONT></TD></TR><TR><TD PORT="approval_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> approval_id</TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> document_id</TD></TR><TR><TD PORT="approver_user_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> approver_user_id</TD></TR><TR><TD PORT="approval_status" ALIGN="LEFT">approval_status</TD></TR></TABLE>>]
document_history [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>document_history</B></FONT></TD></TR><TR><TD PORT="history_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> history_id</TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> document_id</TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> user_id</TD></TR><TR><TD PORT="action_type" ALIGN="LEFT">action_type</TD></TR></TABLE>>]
document_comments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>document_comments</B></FONT></TD></TR><TR><TD PORT="comment_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> comment_id</TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> document_id</TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> user_id</TD></TR><TR><TD PORT="comment_text" ALIGN="LEFT">comment_text</TD></TR></TABLE>>]
attachments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b4c9d8" BGCOLOR="#f1f7fa"><TR><TD ALIGN="LEFT" BGCOLOR="#17324a"><FONT COLOR="#ffffff"><B>attachments</B></FONT></TD></TR><TR><TD PORT="attachment_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>PK</B></FONT> attachment_id</TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> document_id</TD></TR><TR><TD PORT="uploaded_by_user_id" ALIGN="LEFT"><FONT COLOR="#18587c"><B>FK</B></FONT> uploaded_by_user_id</TD></TR><TR><TD PORT="file_name" ALIGN="LEFT">file_name</TD></TR></TABLE>>]
roles:role_id -> users:role_id
departments:department_id -> users:department_id
document_types:document_type_id -> documents:document_type_id
document_statuses:status_id -> documents:status_id
departments:department_id -> documents:department_id
users:user_id -> documents:created_by_user_id
documents:document_id -> document_executors:document_id
users:user_id -> document_executors:user_id
users:user_id -> document_executors:assigned_by_user_id
documents:document_id -> document_approvals:document_id
users:user_id -> document_approvals:approver_user_id
documents:document_id -> document_history:document_id
users:user_id -> document_history:user_id
documents:document_id -> document_comments:document_id
users:user_id -> document_comments:user_id
documents:document_id -> attachments:document_id
users:user_id -> attachments:uploaded_by_user_id
}
